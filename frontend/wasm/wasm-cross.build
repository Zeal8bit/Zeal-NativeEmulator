[binaries]
c = 'emcc'
cpp = 'em++'
ar = 'emar'
ld = 'emcc'
strip = 'strip'  # optional
pkg-config = 'false'   # pkg-config is often not available for wasm
exe_wrapper = 'node'  # allows Meson to run test programs if needed

[project options]
show_fps = false
enable_debugger = false

[host_machine]
system = 'emscripten'
cpu_family = 'wasm32'
cpu = 'wasm32'
endian = 'little'
